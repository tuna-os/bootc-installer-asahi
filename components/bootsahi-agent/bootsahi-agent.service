[Unit]
Description=Bootsahi first-boot agent (install-config.json -> unattended bootc install)
Documentation=https://github.com/tuna-os/bootc-installer-asahi
# Apple Silicon only. NOT ConditionKernelVersion=asahi: systemd implies "$="
# (shell-style glob) when no operator is given, so a wildcard-less "asahi"
# matches only a kernel release literally EQUAL to "asahi" — never a real one
# like 7.0.13-400.asahi.fc42.aarch64+16k. That silently skipped this unit on
# every boot, so the agent has never run (issue #23). Kernel strings are the
# wrong predicate anyway: Arch's linux-asahi reports KERNELRELEASE
# "7.0.13-1-1-ARCH", with no "asahi" in it at all.
#
# This is a cheap non-DT-hardware skip; the authoritative "apple," check on
# /proc/device-tree/compatible lives in the script, mirroring
# asahi-bootbin-sync.sh.
ConditionPathExists=/proc/device-tree/compatible
After=network-online.target local-fs.target
Wants=network-online.target
# greetd's fisherman-driven interactive UI is the fallback: it must not race
# this unit, and should only actually show a login/wizard screen once this
# unit has either found nothing to do (exit 2) or failed (exit 1). On success
# this unit reboots the machine itself, so greetd never starts this boot.
Before=greetd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/bootsahi-agent
# exit 2 = no install-config.json present yet: the expected state on every
# boot before the macOS app has written one. Not a failure worth systemd
# marking the unit "failed" over.
SuccessExitStatus=2
# The install itself (image pull + bootc deploy) can legitimately take many
# minutes on a slow network; do not impose a start timeout.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
