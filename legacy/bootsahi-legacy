#!/bin/bash
# bootsahi-legacy — non-destructive compatibility preflight for Intel/T2 Macs.
#
# This intentionally does not repartition disks or alter Startup Security.
# The legacy installer UI is meant to run it before offering the USB migration
# flow; `--json` is the stable machine-readable interface for that caller.
set -euo pipefail

min_macos="10.13"
model="$(/usr/sbin/sysctl -n hw.model)"
macos="$(/usr/bin/sw_vers -productVersion)"

version_at_least() {
  local -a a b
  IFS=. read -r -a a <<<"$1"
  IFS=. read -r -a b <<<"$2"
  local i
  for i in 0 1 2; do
    local av="${a[i]:-0}" bv="${b[i]:-0}"
    ((10#$av > 10#$bv)) && return 0
    ((10#$av < 10#$bv)) && return 1
  done
  return 0
}

is_t2_model() {
  case "$1" in
    iMac20,1|iMac20,2|iMacPro1,1|MacBookAir8,1|MacBookAir8,2|MacBookAir9,1|MacBookPro15,1|MacBookPro15,2|MacBookPro15,3|MacBookPro15,4|MacBookPro16,1|MacBookPro16,2|MacBookPro16,3|MacBookPro16,4|Macmini8,1|MacPro7,1) return 0 ;;
    *) return 1 ;;
  esac
}

profile="generic-intel"
is_t2_model "$model" && profile="t2"
status="supported"
reason=""
if ! version_at_least "$macos" "$min_macos"; then
  status="unsupported"
  reason="Bootsahi Legacy requires macOS 10.13 High Sierra or newer."
fi

if [[ "${1:-}" == "--json" ]]; then
  printf '{"status":"%s","profile":"%s","model":"%s","macos":"%s","minimum_macos":"%s","reason":"%s"}\n' \
    "$status" "$profile" "$model" "$macos" "$min_macos" "$reason"
else
  printf 'Bootsahi Legacy preflight\n'
  printf '  Model: %s\n  macOS: %s\n' "$model" "$macos"
  if [[ "$status" == "supported" ]]; then
    printf '  Result: supported Intel Mac (%s profile)\n' "$profile"
    if [[ "$profile" == "t2" ]]; then
      printf '\nNext: prepare the local Broadcom firmware hand-off and boot the TunaOS T2 installer USB.\n'
    else
      printf '\nNext: boot a standard x86_64 TunaOS installer USB.\n'
    fi
  else
    printf '  Result: unsupported — %s\n' "$reason" >&2
    exit 1
  fi
fi
